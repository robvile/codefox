{
  "name": "codefox",
  "version": "0.21.5",
  "description": "Local AI coding assistant \u2014 runs entirely on your machine, with LM Studio (default) or Ollama",
  "main": "main.js",
  "author": "CodeFox Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/embed-bridge.js",
    "postinstall": "node scripts/embed-bridge.js && node scripts/prepare-icons.js",
    "build": "node scripts/embed-bridge.js && node scripts/prepare-icons.js && npm run clean && electron-builder",
    "build:win": "node scripts/embed-bridge.js && node scripts/prepare-icons.js && npm run clean && electron-builder --win",
    "build:mac": "node scripts/embed-bridge.js && node scripts/prepare-icons.js && npm run clean && electron-builder --mac",
    "build:linux": "node scripts/embed-bridge.js && node scripts/prepare-icons.js && npm run clean && electron-builder --linux",
    "test": "node test/smoke.js",
    "eval": "node scripts/eval-runner.js --suite canary",
    "eval:canary": "node scripts/eval-runner.js --suite canary",
    "eval:full": "node scripts/eval-runner.js --suite full",
    "eval:mock": "node scripts/eval-runner.js --suite canary --mock",
    "mcp": "node mcp-server/server.js",
    "clean": "node scripts/clean-dist.js"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.codefox.app",
    "productName": "CodeFox",
    "icon": "build/icon.png",
    "copyright": "Copyright \u00a9 2026 CodeFox Contributors",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "index.html",
      "package.json",
      "upm-manifest.js",
      "unity-assets.js",
      "mcp-presets.js",
      "unity-bridge.js",
      "unity-bridge-source.js",
      "unity-command.js",
      "unity-companion/**/*",
      "node_modules/**/*",
      "build/icon.png",
      "comfyui.js",
      "comfyui-client.js",
      "comfyui-workflows.js",
      "comfyui-scan.js",
      "lmstudio-load.js",
      "git-backup.js",
      "file-tools.js",
      "log-triage.js",
      "context-budget.js",
      "turn-ledger.js",
      "docs-search.js",
      "model-profiles.js",
      "docs-engine.js",
      "mcp-server/**/*",
      "skill-files.js",
      "skills/**/*",
      "eval/**/*",
      "scripts/eval-runner.js"
    ],
    "asarUnpack": [
      "mcp-server/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CodeFox-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeFox"
    },
    "artifactName": "CodeFox-Setup.${ext}"
  }
}
