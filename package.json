{
  "name": "codefox",
  "version": "1.0.0",
  "description": "Local AI coding assistant — runs entirely on your machine",
  "main": "main.js",
  "author": "CodeFox Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.codefox.app",
    "productName": "CodeFox",
    "copyright": "Copyright © 2026 CodeFox Contributors",
    "directories": { "output": "dist" },
    "files": ["main.js","preload.js","app.js","index.html","package.json","node_modules/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "mac": { "target": [{ "target": "dmg", "arch": ["x64","arm64"] }], "category": "public.app-category.developer-tools" },
    "linux": { "target": ["AppImage","deb"], "category": "Development" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "CodeFox" }
  }
}